# Base URL used by the browser. Keep the relative default when using the Vite
# proxy below; set an absolute URL when the API lives on another origin.
VITE_API_BASE_URL=/api/v1

# Dev-server proxy target for /api/* requests.
VITE_API_PROXY_TARGET=http://localhost:3000

# Optional demo credentials pre-filled on the gate page. Leave the password
# empty in shared environments.
VITE_DEMO_EMAIL=admin@example.com
VITE_DEMO_PASSWORD=Admin@123456
